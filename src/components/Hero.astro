---
/**
 * Hero —— 左侧简介区（v2：空灵 / 左对齐）
 *
 * 头像、站名、中文名、标语、装饰语全部来自 config/site.yaml 的 hero 块，
 * 本组件不做任何内容兜底或写死。社交行由 SocialLinks 单独渲染。
 */
import { getSiteConfig } from '../config/loader';

const config = getSiteConfig();
const { hero, site, animation } = config;

const entrance = animation.enabled && animation.entrance.enabled;

/** 描述按换行拆成多行文本（过滤空行） */
const descriptionLines = hero.description
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line.length > 0);

const showAvatar = hero.avatar?.enabled === true;
const showDecoration = Boolean(hero.decoration?.enabled && hero.decoration?.text);
const decorationText = hero.decoration?.text ?? '';

/** 依次入场的小节拍（固定编排，非站点信息） */
const delays = {
  avatar: 0,
  title: entrance ? 90 : 0,
  subtitle: entrance ? 170 : 0,
  desc: entrance ? 250 : 0,
  deco: entrance ? 320 : 0,
} as const;
---

{
  hero.enabled && (
    <div class="hero">
      {showAvatar && (
        <img
          class:list={['hero__avatar', { entrance }]}
          style={entrance ? `--delay:${delays.avatar}ms` : undefined}
          src={site.avatar}
          alt=""
          width={92}
          height={92}
          loading="eager"
          decoding="async"
        />
      )}

      <h1
        class:list={['hero__title', { entrance }]}
        style={entrance ? `--delay:${delays.title}ms` : undefined}
      >
        {hero.title}
      </h1>

      <p
        class:list={['hero__subtitle', { entrance }]}
        style={entrance ? `--delay:${delays.subtitle}ms` : undefined}
      >
        {hero.subtitle}
      </p>

      <p
        class:list={['hero__desc', { entrance }]}
        style={entrance ? `--delay:${delays.desc}ms` : undefined}
      >
        {descriptionLines.map((line) => <span>{line}</span>)}
      </p>

      {showDecoration && (
        <p
          class:list={['hero__deco', { entrance }]}
          style={entrance ? `--delay:${delays.deco}ms` : undefined}
        >
          {decorationText}
        </p>
      )}
    </div>
  )
}
