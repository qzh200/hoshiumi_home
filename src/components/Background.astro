---
/**
 * Background —— 背景场景（纯 CSS / 静态 HTML）
 *
 * 全部由 config/site.yaml 的 background 与 theme 驱动：
 *   - 基础底色          = theme.{light,dark}.background（CSS 变量）
 *   - 渐变氛围 / 光斑    = background.gradient / glow
 *   - 星星              = background.stars（位置用固定随机种子，构建可复现）
 *   - 噪点              = background.noise
 *   - 图片              = background.image（可选，置于最底层之上）
 *
 * 不依赖 Canvas 与任何运行时脚本。
 */
import { getSiteConfig } from '../config/loader';

const config = getSiteConfig();
const { background, animation } = config;

const starsEnabled = background.stars.enabled && background.stars.count > 0;
const motionEnabled = animation.enabled && animation.background.enabled;
const sceneClasses: string[] = [];
if (background.gradient) sceneClasses.push('bg-scene--gradient');
if (motionEnabled) sceneClasses.push('bg-scene--moving');
if (motionEnabled && starsEnabled) sceneClasses.push('bg-scene--twinkle');

/* ------------------------------------------------------------------ */
/* 星星：使用固定种子生成可复现的伪随机位置                          */
/* ------------------------------------------------------------------ */
interface StarStyle {
  left: string;
  top: string;
  animationDelay: string;
  animationDuration: string;
  kind: 'sm' | 'lg';
}

function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function hashString(value: string): number {
  let hash = 2166136261;
  for (let i = 0; i < value.length; i++) {
    hash ^= value.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

const seedBase = `${config.site.url}#stars`;
const rand = mulberry32(hashString(seedBase));

const stars: StarStyle[] = [];
if (starsEnabled) {
  const count = background.stars.count;
  for (let i = 0; i < count; i++) {
    stars.push({
      left: `${Math.round(rand() * 98)}%`,
      top: `${Math.round(rand() * 96)}%`,
      // 闪烁节奏错开，避免整体“呼吸感”
      animationDelay: `${(rand() * 6).toFixed(2)}s`,
      animationDuration: `${(4.5 + rand() * 4.5).toFixed(2)}s`,
      kind: rand() > 0.82 ? 'lg' : 'sm',
    });
  }
}

/* ------------------------------------------------------------------ */
/* 光斑动画时长：随 background speed 变化                              */
/* ------------------------------------------------------------------ */
const speedMap = { slow: [72, 92, 112], normal: [46, 58, 70], fast: [26, 34, 42] } as const;
const [dur1, dur2, dur3] = speedMap[animation.background.speed];
---

<div class:list={['bg-scene', ...sceneClasses]} aria-hidden="true">
  {background.image.enabled && background.image.src && (
    <div
      class="bg-scene__layer bg-scene__image"
      style={`background-image:url(${background.image.src});opacity:var(--bg-image-opacity,0.6)`}
    />
  )}

  {background.gradient && <div class="bg-scene__layer bg-scene__tint" />}

  {background.type === 'aurora' && background.glow && (
    <div
      class="bg-scene__layer"
      style={`--orb-dur-1:${dur1}s;--orb-dur-2:${dur2}s;--orb-dur-3:${dur3}s`}
    >
      <div class="orb orb--a" />
      <div class="orb orb--b" />
      <div class="orb orb--c" />
    </div>
  )}

  {starsEnabled && (
    <div class="bg-scene__layer">
      {stars.map((star) => (
        <i
          class:list={['star', star.kind === 'lg' ? 'star--lg' : 'star--sm']}
          style={`left:${star.left};top:${star.top};animation-delay:${star.animationDelay};animation-duration:${star.animationDuration}`}
        />
      ))}
    </div>
  )}

  {background.noise && <div class="bg-scene__layer bg-scene__noise" />}
</div>
